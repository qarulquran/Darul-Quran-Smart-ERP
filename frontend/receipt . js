document.addEventListener("DOMContentLoaded", function(){



let payment = JSON.parse(

localStorage.getItem("lastReceipt")

);




// যদি lastReceipt না থাকে তাহলে fees থেকে নেবে

if(!payment){


let fees = JSON.parse(

localStorage.getItem("fees")

) || [];



if(fees.length > 0){

payment = fees[fees.length - 1];

}


}





if(!payment){


alert("No Receipt Data Found");

return;


}







// ===============================
// Receipt Info
// ===============================


document.getElementById("receiptNo").innerText =

payment.receiptNo || "-";



document.getElementById("paymentDate").innerText =

payment.paymentDate || "-";









// ===============================
// Student Info
// ===============================


let students = JSON.parse(

localStorage.getItem("students")

) || [];





let student = students.find(s =>


String(s.studentCode).trim()

===

String(payment.studentCode).trim()


);





document.getElementById("studentName").innerText =

(student && student.name)

?

student.name

:

payment.studentName || "-";





document.getElementById("studentCode").innerText =

payment.studentCode || "-";





document.getElementById("studentClass").innerText =

(student && student.admissionClass)

?

student.admissionClass

:

"-";





document.getElementById("fatherName").innerText =

(student && student.fatherName)

?

student.fatherName

:

payment.fatherName || "-";










// ===============================
// Payment Info
// ===============================


document.getElementById("feeType").innerText =

payment.feeType || "-";





document.getElementById("feeMonth").innerText =

payment.month || "-";





document.getElementById("amount").innerText =

payment.amount || "0";





document.getElementById("paymentMethod").innerText =

payment.paymentMethod || "-";










// ===============================
// Barcode
// ===============================


let barcodeBox = document.getElementById("barcode");



if(barcodeBox){


barcodeBox.innerHTML="";



let img = document.createElement("img");



img.src =

"https://barcode.tec-it.com/barcode.ashx?data="

+

encodeURIComponent(

payment.receiptNo

)

+

"&code=Code128";





img.style.width="260px";



barcodeBox.appendChild(img);



}




});
