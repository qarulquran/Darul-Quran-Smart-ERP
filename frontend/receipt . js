function getFees(){

return JSON.parse(

localStorage.getItem("fees")

) || [];

}



function getStudents(){

return JSON.parse(

localStorage.getItem("students")

) || [];

}






// ===============================
// Barcode Generate
// ===============================


function generateBarcode(data){


let barcodeBox =

document.getElementById("barcode");



if(barcodeBox){


barcodeBox.innerHTML="";



let img=document.createElement("img");



img.src=

"https://barcode.tec-it.com/barcode.ashx?data="

+

encodeURIComponent(data)

+

"&code=Code128";



img.style.width="260px";



barcodeBox.appendChild(img);


}


}









// ===============================
// Load Latest Receipt
// ===============================


let fees=getFees();



let receipt =

fees[fees.length-1];








if(receipt){





// Receipt Information


document.getElementById(

"receiptNo"

).innerText =

receipt.receiptNo || "-";





document.getElementById(

"paymentDate"

).innerText =

receipt.paymentDate || "-";







// Payment Information



document.getElementById(

"feeType"

).innerText =

receipt.feeType || "-";





document.getElementById(

"feeMonth"

).innerText =

receipt.month || "-";







document.getElementById(

"amount"

).innerText =

receipt.amount || "0";







document.getElementById(

"paymentMethod"

).innerText =

receipt.paymentMethod || "-";









// Student Information


let students=getStudents();




let student = students.find(item =>



item.studentCode === receipt.studentCode



);






if(student){





document.getElementById(

"studentName"

).innerText =

student.name || "-";






document.getElementById(

"studentCode"

).innerText =

student.studentCode || "-";






document.getElementById(

"studentClass"

).innerText =

student.admissionClass || "-";






document.getElementById(

"fatherName"

).innerText =

student.fatherName || "-";









// Barcode Data



let barcodeData =



"Receipt: "

+

receipt.receiptNo

+

"|"

+

"Student: "

+

student.studentCode

+

"|"

+

"Amount: "

+

receipt.amount;







generateBarcode(barcodeData);







}






}

else{



alert(

"No Receipt Found"

);



window.location.href="fee.html";


}
