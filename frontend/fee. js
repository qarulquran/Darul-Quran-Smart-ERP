function getFees(){

return JSON.parse(

localStorage.getItem("fees")

) || [];

}





function saveFees(data){

localStorage.setItem(

"fees",

JSON.stringify(data)

);

}







// Generate Receipt Number


function generateReceiptNo(){


let fees = getFees();


let year = new Date().getFullYear();


let number = fees.length + 1;



return (

"MR-"

+

year

+

"-"

+

String(number).padStart(5,"0")

);


}








// Save Payment


const saveButton = document.getElementById(

"savePayment"

);






if(saveButton){


saveButton.addEventListener(

"click",

function(){



let payment = {


receiptNo:

generateReceiptNo(),



studentCode:

document.getElementById(

"studentCode"

).value,



feeType:

document.getElementById(

"feeType"

).value,



month:

document.getElementById(

"month"

).value,



amount:

document.getElementById(

"amount"

).value,



paymentMethod:

document.getElementById(

"paymentMethod"

).value,



paymentDate:

new Date()

.toISOString()

.substring(0,10)



};







if(!payment.studentCode || !payment.amount){


alert(

"Student Code and Amount Required"

);


return;


}






let fees=getFees();



fees.push(payment);



saveFees(fees);







alert(

"Payment Saved Successfully\nReceipt: "

+

payment.receiptNo

);







window.location.href=

"receipt.html";





});


}
