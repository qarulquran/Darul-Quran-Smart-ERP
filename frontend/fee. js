let selectedStudent = null;


// Get Students

function getStudents(){

    return JSON.parse(
        localStorage.getItem("students")
    ) || [];

}


// Get Fees

function getFees(){

    return JSON.parse(
        localStorage.getItem("fees")
    ) || [];

}



// Save Fees

function saveFees(data){

    localStorage.setItem(
        "fees",
        JSON.stringify(data)
    );

}



// ===============================
// Search Student
// ===============================


document
.getElementById("searchStudent")
.addEventListener("click",function(){


let code =
document
.getElementById("studentCode")
.value
.trim()
.toLowerCase();



let students=getStudents();



let student=students.find(s=>

String(s.studentCode)
.trim()
.toLowerCase()
=== code

);



if(student){


selectedStudent=student;



document.getElementById("studentPhoto").src =
student.photo ||
"https://via.placeholder.com/120";



document.getElementById("studentName")
.innerText =
student.name || "-";



document.getElementById("showStudentCode")
.innerText =
student.studentCode || "-";



document.getElementById("studentClass")
.innerText =
student.admissionClass || "-";



document.getElementById("fatherName")
.innerText =
student.fatherName || "-";



document.getElementById("guardianMobile")
.innerText =
student.guardianMobile || "-";



alert("Student Found Successfully");


}

else{


alert("Student Not Found");


}



});







// ===============================
// Save Payment
// ===============================


document
.getElementById("savePayment")
.addEventListener("click",function(){



if(!selectedStudent){


alert(
"আগে Student Search করুন"
);


return;


}




let amount =
document
.getElementById("amount")
.value;



if(!amount){


alert(
"Amount দিন"
);


return;


}




let fees=getFees();



let receiptNo =
"MR-" +
new Date().getFullYear()
+
"-"
+
String(fees.length+1)
.padStart(5,"0");





let payment={


receiptNo:receiptNo,


studentCode:
selectedStudent.studentCode,


studentName:
selectedStudent.name,


feeType:
document.getElementById("feeType").value,


month:
document.getElementById("month").value,


amount:amount,


paymentMethod:
document.getElementById("paymentMethod").value,


paymentDate:
new Date().toLocaleDateString("bn-BD")



};




fees.push(payment);



saveFees(fees);



alert(
"Payment Saved Successfully\nReceipt No: "
+
receiptNo
);



localStorage.setItem(
"lastReceipt",
JSON.stringify(payment)
);



window.location.href="receipt.html";



});
