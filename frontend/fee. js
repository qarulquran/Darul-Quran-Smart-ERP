// ===============================
// Get Students
// ===============================


function getStudents(){


    return JSON.parse(

        localStorage.getItem("students")

    ) || [];


}







// ===============================
// Get Fees
// ===============================


function getFees(){


    return JSON.parse(

        localStorage.getItem("fees")

    ) || [];


}







// ===============================
// Search Student
// ===============================


const searchButton =

document.getElementById(

"searchStudent"

);







if(searchButton){


searchButton.addEventListener(

"click",

function(){



let code =

document.getElementById(

"studentCode"

).value.trim();





let students = getStudents();





let student = students.find(student =>



student.studentCode === code



);







if(student){



document.getElementById(

"studentInfo"

).style.display="flex";





document.getElementById(

"studentName"

).innerText =

student.name || "";





document.getElementById(

"fatherName"

).innerText =

student.fatherName || "";





document.getElementById(

"studentClass"

).innerText =

student.admissionClass || "";





document.getElementById(

"guardianMobile"

).innerText =

student.guardianMobile || "";





document.getElementById(

"showCode"

).innerText =

student.studentCode;






if(student.photo){


document.getElementById(

"studentPhoto"

).src = student.photo;


}





// Save selected student

localStorage.setItem(

"feeStudent",

student.studentCode

);



}

else{


alert(

"Student Not Found"

);



}



});


}








// ===============================
// Generate Receipt Number
// ===============================


function generateReceiptNumber(){



let fees = getFees();




let year =

new Date()

.getFullYear();





let number =

fees.length + 1;





return (

"MR-"

+

year

+

"-"

+

String(number)

.padStart(5,"0")

);



}








// ===============================
// Save Payment
// ===============================


const saveButton =

document.getElementById(

"savePayment"

);







if(saveButton){


saveButton.addEventListener(

"click",

function(){





let studentCode =

localStorage.getItem(

"feeStudent"

);





if(!studentCode){


alert(

"Please Search Student First"

);


return;


}







let fee = {



receiptNo:

generateReceiptNumber(),





studentCode:

studentCode,





feeType:

document.getElementById(

"feeType"

).value,





month:

document.getElementById(

"feeMonth"

).value,





amount:

document.getElementById(

"amount"

).value,





paymentMethod:

document.getElementById(

"paymentMethod"

).value,





paymentDate:

document.getElementById(

"paymentDate"

).value,





createdAt:

new Date()

.toISOString()



};






let fees = getFees();





fees.push(fee);






localStorage.setItem(

"fees",

JSON.stringify(fees)

);







alert(

"Payment Saved Successfully\n\nReceipt No:\n"

+

fee.receiptNo

);






// Future Receipt Page

window.location.href =

"receipt.html";





});


}
