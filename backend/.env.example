# ==========================================
# ISM Smart ERP - Backend Environment
# ==========================================

# Application
NODE_ENV=development
PORT=5000

# API
API_PREFIX=/api/v1

# ==========================================
# PostgreSQL Database
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ism_smart_erp
DB_USER=postgres
DB_PASSWORD=change_this_password

# Enable SSL in production when required
DB_SSL=false

# ==========================================
# Authentication
# ==========================================

# Replace with a long random secret in production
JWT_SECRET=change_this_to_a_long_random_secret

# Access token lifetime
JWT_EXPIRES_IN=1h

# ==========================================
# CORS
# ==========================================

# Current frontend origin.
# Change this according to the production frontend URL.
FRONTEND_URL=https://qarulquran.github.io

# ==========================================
# Security
# ==========================================

BCRYPT_ROUNDS=12
