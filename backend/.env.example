# ==========================================
# ISM Smart ERP - Backend Environment
# ==========================================

# ==========================================
# Application
# ==========================================

NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# ==========================================
# API
# ==========================================

API_PREFIX=/api/v1

# ==========================================
# PostgreSQL Database
# ==========================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ism_smart_erp
DB_USER=postgres
DB_PASSWORD=change_this_password

# Enable SSL when required by the
# production PostgreSQL provider.
DB_SSL=false

# ==========================================
# PostgreSQL Connection Pool
# ==========================================

DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# ==========================================
# Authentication / JWT
# ==========================================

# IMPORTANT:
# Replace this with a long, random,
# private secret in the real environment.
#
# Never commit the real secret to GitHub.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_characters

# Access token lifetime
JWT_EXPIRES_IN=1h

# ==========================================
# Password Security
# ==========================================

# bcrypt cost factor.
# Recommended range in this project: 10-15.
BCRYPT_SALT_ROUNDS=12

# ==========================================
# CORS
# ==========================================

# Development:
# CORS_ORIGIN=*

# Production example:
CORS_ORIGIN=https://qarulquran.github.io

# Multiple allowed origins can later be supplied
# as a comma-separated list.
#
# Example:
# CORS_ORIGIN=https://example.com,https://admin.example.com
